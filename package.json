{
  "name": "@proladon/shelter-ui",
  "version": "2.0.1",
  "type": "module",
  "description": "shelter vue ui components",
  "author": "Proladon",
  "license": "MIT",
  "keywords": [
    "vue",
    "components",
    "ui"
  ],
  "main": "dist/shelter-ui.cjs.js",
  "module": "dist/shelter-ui.js.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/shelter-ui.js.js",
      "require": "./dist/shelter-ui.cjs.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js.js",
      "require": "./dist/core.cjs.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js.js",
      "require": "./dist/preset.cjs.js"
    },
    "./dist/index.css": {
      "import": "./dist/index.css",
      "require": "./dist/index.css"
    },
    "./components-catalog.json": "./components-catalog.json",
    "./SKILL.md": "./SKILL.md"
  },
  "files": [
    "dist",
    "components-catalog.json",
    "SKILL.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lib:build": "vue-tsc -b && vite build",
    "lib:publish": "yarn publish",
    "prepublishOnly": "npm run lib:build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@tabler/icons-vue": "^3.40.0",
    "@unocss/reset": "^66.6.7",
    "@vueuse/core": "^14.2.1",
    "color": "^5.0.3",
    "reka-ui": "^2.9.2",
    "vue": "^3.5.30"
  },
  "devDependencies": {
    "@types/color": "^4.2.1",
    "@types/node": "^25.5.0",
    "@unocss/transformer-directives": "^66.6.7",
    "@unocss/transformer-variant-group": "^66.6.7",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "happy-dom": "^20.8.4",
    "typescript": "^5.9.3",
    "unocss": "^66.6.7",
    "vite": "^8.0.1",
    "vite-bundle-analyzer": "^1.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "@internationalized/date": "^3.12.0"
    }
  }
}
